        </mxCell>
        <mxCell id="desk_xterm" value="xterm.js v6" style="text;html=1;fontSize=9;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#80CBC4;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="desk_term">
          <mxGeometry x="8" y="5" width="100" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="desk_prompt" value="customer-a:/workspace$ claude&#xa;&lt;span style='color:#4FC3F7'&gt;claude&lt;/span&gt; What should I work on?" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#A5D6A7;fontFamily=monospace;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="desk_term">
          <mxGeometry x="8" y="22" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="desk_tab" value="Terminal.jsx — tabbed panel&#xa;One tab per container connection" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#888888;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="desktop">
          <mxGeometry x="15" y="145" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="desk_ws" value="WebSocket" style="text;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1565C0;" vertex="1" parent="desktop">
          <mxGeometry x="75" y="177" width="100" height="16" as="geometry"/>
        </mxCell>

        <!-- ===== DEVICE B: MOBILE ===== -->
        <mxCell id="mobile" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="250" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="mob_label" value="&lt;b&gt;Mobile Browser&lt;/b&gt;" style="text;html=1;fontSize=13;align=center;verticalAlign=top;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;rounded=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="mobile">
          <mxGeometry x="35" y="8" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="mob_term" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#455A64;container=1;collapsible=0;" vertex="1" parent="mobile">
          <mxGeometry x="15" y="45" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="mob_xterm" value="xterm.js v6" style="text;html=1;fontSize=9;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#80CBC4;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="mob_term">
          <mxGeometry x="8" y="5" width="100" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="mob_prompt" value="customer-a:/workspace$ claude&#xa;&lt;span style='color:#4FC3F7'&gt;claude&lt;/span&gt; What should I work on?" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#A5D6A7;fontFamily=monospace;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="mob_term">
          <mxGeometry x="8" y="22" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mob_note" value="Same session content visible&#xa;on both devices simultaneously" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#888888;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="mobile">
          <mxGeometry x="15" y="145" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="mob_ws" value="WebSocket" style="text;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1565C0;" vertex="1" parent="mobile">
          <mxGeometry x="75" y="177" width="100" height="16" as="geometry"/>
        </mxCell>

        <!-- ===== MANAGER CONTAINER ===== -->
        <mxCell id="manager" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="300" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="mgr_label" value="&lt;b&gt;claude-manager&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=#E65100;fontColor=#FFFFFF;strokeColor=none;rounded=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="manager">
          <mxGeometry x="50" y="8" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- terminal.js route -->
        <mxCell id="term_route" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;container=1;collapsible=0;" vertex="1" parent="manager">
          <mxGeometry x="15" y="50" width="270" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="tr_label" value="&lt;b&gt;routes/terminal.js&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="term_route">
          <mxGeometry x="10" y="5" width="200" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="tr_endpoint" value="GET /api/instances/:id/terminal" style="text;html=1;fontSize=9;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;fontFamily=monospace;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="term_route">
          <mxGeometry x="10" y="25" width="250" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="tr_desc" value="1. Verify container exists &amp; running&#xa;2. Call createPTY(id)&#xa;3. Pipe: container stdout → WebSocket&#xa;4. Pipe: WebSocket input → container stdin&#xa;5. Handle resize messages (JSON)&#xa;6. On disconnect: tmux detach (Ctrl-b d)&#xa;   → session persists for reconnect" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="term_route">
          <mxGeometry x="10" y="45" width="250" height="105" as="geometry"/>
        </mxCell>

        <!-- docker.js createPTY -->
        <mxCell id="create_pty" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;container=1;collapsible=0;" vertex="1" parent="manager">
          <mxGeometry x="15" y="230" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cp_label" value="&lt;b&gt;docker.js → createPTY()&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="create_pty">
          <mxGeometry x="10" y="5" width="200" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="cp_desc" value="docker exec into container with:&#xa;  tmux -L cm -f /dev/null \&#xa;    new-session -A -s main&#xa;&#xa;-A = attach if exists, create if not&#xa;-L cm = separate socket (no conflicts)&#xa;-f /dev/null = ignore user .tmux.conf" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;fontFamily=monospace;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="create_pty">
          <mxGeometry x="10" y="25" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- Docker socket -->
        <mxCell id="docker_sock" value="docker.sock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="manager">
          <mxGeometry x="75" y="375" width="150" height="30" as="geometry"/>
        </mxCell>

        <!-- docker exec label -->
        <mxCell id="exec_label" value="docker exec&#xa;(hijack: true, TTY)" style="text;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="manager">
          <mxGeometry x="75" y="415" width="150" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== WORKSPACE CONTAINER ===== -->
        <mxCell id="workspace" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="90" width="300" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="ws_label" value="&lt;b&gt;cm-customer-a-a1b2c3d4&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=none;rounded=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="workspace">
          <mxGeometry x="25" y="8" width="250" height="25" as="geometry"/>
        </mxCell>

        <!-- tmux -->
        <mxCell id="tmux" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;container=1;collapsible=0;" vertex="1" parent="workspace">
          <mxGeometry x="15" y="50" width="270" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="tmux_label" value="&lt;b&gt;tmux (socket: cm, session: main)&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#2E7D32;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="tmux">
          <mxGeometry x="10" y="5" width="260" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="tmux_desc" value="Terminal multiplexer — single shared session&#xa;&#xa;• Session persists across WebSocket disconnects&#xa;• Multiple clients attach to same session&#xa;• &quot;window-size latest&quot; — uses most recent&#xa;  client's terminal dimensions&#xa;• Separate -L cm socket avoids conflicts&#xa;  with user's own tmux sessions&#xa;• Falls back to /bin/bash if tmux unavailable" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="tmux">
          <mxGeometry x="10" y="28" width="250" height="170" as="geometry"/>
        </mxCell>

        <!-- Shell + Claude Code -->
        <mxCell id="shell" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;container=1;collapsible=0;" vertex="1" parent="workspace">
          <mxGeometry x="15" y="280" width="270" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="shell_label" value="&lt;b&gt;/bin/bash (inside tmux)&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#2E7D32;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="shell">
          <mxGeometry x="10" y="5" width="200" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="shell_desc" value="TERM=xterm-256color&#xa;Custom PS1 prompt with container name&#xa;Claude Code CLI available (claude command)" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="shell">
          <mxGeometry x="10" y="28" width="250" height="65" as="geometry"/>
        </mxCell>

        <!-- Workspace volume -->
        <mxCell id="ws_vol" value="/workspace (volume)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="workspace">
          <mxGeometry x="15" y="405" width="130" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ws_mem" value="/workspace/.claude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="workspace">
          <mxGeometry x="155" y="405" width="130" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ws_home" value="~/.claude (shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="workspace">
          <mxGeometry x="15" y="445" width="130" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ws_shared" value="/shared" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="workspace">
          <mxGeometry x="155" y="445" width="130" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->
        <!-- Desktop → Manager -->
        <mxCell id="e_desk_mgr" value="ws://host:3000/api/&#xa;instances/:id/terminal" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=2;fontSize=8;fontColor=#1565C0;" edge="1" source="desktop" target="term_route" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="190"/>
              <mxPoint x="320" y="190"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Mobile → Manager -->
        <mxCell id="e_mob_mgr" value="ws://host:3000/api/&#xa;instances/:id/terminal" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=2;fontSize=8;fontColor=#1565C0;" edge="1" source="mobile" target="term_route" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="440"/>
              <mxPoint x="320" y="180"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Manager → Workspace -->
        <mxCell id="e_mgr_ws" value="docker exec&#xa;(TTY + stdin)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=2;fontSize=9;fontColor=#E65100;" edge="1" source="docker_sock" target="tmux" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== KEY FEATURES BOX ===== -->
        <mxCell id="features" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="580" height="275" as="geometry"/>
        </mxCell>
        <mxCell id="feat_label" value="&lt;b&gt;How shared sessions work&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#F9A825;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="features">
          <mxGeometry x="15" y="8" width="300" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="feat1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;container=1;collapsible=0;" vertex="1" parent="features">
          <mxGeometry x="15" y="40" width="265" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f1_label" value="&lt;b&gt;1. First device connects&lt;/b&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1565C0;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat1">
          <mxGeometry x="8" y="5" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="f1_desc" value="WebSocket → terminal.js → createPTY()&#xa;→ docker exec: tmux new-session -A -s main&#xa;tmux creates new session &quot;main&quot;&#xa;Two-way pipe: xterm.js ↔ tmux stdin/stdout" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat1">
          <mxGeometry x="8" y="24" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="feat2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;container=1;collapsible=0;" vertex="1" parent="features">
          <mxGeometry x="298" y="40" width="265" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f2_label" value="&lt;b&gt;2. Second device connects&lt;/b&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#2E7D32;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat2">
          <mxGeometry x="8" y="5" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="f2_desc" value="New WebSocket → new createPTY()&#xa;→ docker exec: tmux new-session -A -s main&#xa;-A flag ATTACHES to existing &quot;main&quot; session&#xa;Both devices see identical terminal output" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat2">
          <mxGeometry x="8" y="24" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="feat3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;container=1;collapsible=0;" vertex="1" parent="features">
          <mxGeometry x="15" y="155" width="265" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f3_label" value="&lt;b&gt;3. Device disconnects&lt;/b&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat3">
          <mxGeometry x="8" y="5" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="f3_desc" value="WebSocket close → send tmux detach (Ctrl-b d)&#xa;→ exec stream destroyed after 200ms&#xa;tmux session &quot;main&quot; keeps running&#xa;Process output continues in background" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat3">
          <mxGeometry x="8" y="24" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="feat4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;container=1;collapsible=0;" vertex="1" parent="features">
          <mxGeometry x="298" y="155" width="265" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f4_label" value="&lt;b&gt;4. Device reconnects&lt;/b&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#7B1FA2;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat4">
          <mxGeometry x="8" y="5" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="f4_desc" value="New WebSocket → createPTY()&#xa;→ tmux -A attaches to persisted &quot;main&quot;&#xa;Full scrollback and running processes visible&#xa;No work lost — picks up exactly where left off" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="feat4">
          <mxGeometry x="8" y="24" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- Protocol details -->
        <mxCell id="protocol" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="620" width="430" height="285" as="geometry"/>
        </mxCell>
        <mxCell id="proto_label" value="&lt;b&gt;WebSocket protocol details&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#7B1FA2;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="protocol">
          <mxGeometry x="15" y="8" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="proto_desc" value="&lt;b&gt;Browser → Server:&lt;/b&gt;&#xa;• Raw keystrokes (binary data) → piped to container stdin&#xa;• JSON resize messages: {&quot;type&quot;:&quot;resize&quot;,&quot;cols&quot;:120,&quot;rows&quot;:40}&#xa;  → exec.resize() to update PTY dimensions&#xa;&#xa;&lt;b&gt;Server → Browser:&lt;/b&gt;&#xa;• Raw terminal output (binary) → xterm.js renders directly&#xa;• Includes ANSI escape codes, colors, cursor movement&#xa;&#xa;&lt;b&gt;Connection lifecycle:&lt;/b&gt;&#xa;• Browser opens WebSocket with instance ID in URL&#xa;• Server verifies container running, creates PTY&#xa;• Bidirectional binary pipe established&#xa;• Auto-reconnect with exponential backoff (1s → 30s max)&#xa;&#xa;&lt;b&gt;Resize detection:&lt;/b&gt;&#xa;• Message starts with '{&quot;type&quot;:&quot;resize&quot;' → parse as control&#xa;• All other messages → raw stdin (no JSON overhead)" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="protocol">
          <mxGeometry x="15" y="30" width="400" height="245" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
