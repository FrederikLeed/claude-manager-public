<mxfile>
  <diagram name="Terminal Sessions" id="terminal">
    <mxGraphModel dx="1400" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Claude Manager — Shared Terminal Sessions" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Multi-device access to the same tmux session · xterm.js v6 + WebSocket + docker exec" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="275" y="48" width="550" height="20" as="geometry"/>
        </mxCell>

        <!-- ===== DEVICE A: DESKTOP ===== -->
        <mxCell id="desktop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="250" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="desk_label" value="&lt;b&gt;Desktop Browser&lt;/b&gt;" style="text;html=1;fontSize=13;align=center;verticalAlign=top;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;rounded=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="desktop">
