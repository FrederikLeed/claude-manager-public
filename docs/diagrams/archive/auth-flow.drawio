<mxfile>
  <diagram name="Device Auth Flow" id="auth-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Claude Manager — Device Authentication Flow" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="First device auto-approved as admin · Subsequent devices require admin approval" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="48" width="500" height="20" as="geometry"/>
        </mxCell>

        <!-- ===== SWIM LANES ===== -->
        <!-- Browser lane -->
        <mxCell id="lane_browser" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="300" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="lb_label" value="&lt;b&gt;Browser (useAuth hook)&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;rounded=1;" vertex="1" parent="lane_browser">
          <mxGeometry x="50" y="5" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Server lane -->
        <mxCell id="lane_server" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="300" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="ls_label" value="&lt;b&gt;Fastify Backend (auth.js)&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;fillColor=#E65100;fontColor=#FFFFFF;strokeColor=none;rounded=1;" vertex="1" parent="lane_server">
          <mxGeometry x="50" y="5" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Admin lane -->
        <mxCell id="lane_admin" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="670" y="80" width="300" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="la_label" value="&lt;b&gt;Admin Device&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=none;rounded=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="70" y="5" width="160" height="25" as="geometry"/>
        </mxCell>

        <!-- ===== FLOW STEPS ===== -->

        <!-- Step 1: Page load -->
        <mxCell id="s1" value="User opens&#xa;http://host:3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="200" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 2: Check status -->
        <mxCell id="s2" value="GET /api/auth/status&#xa;(send cookie if exists)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="185" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s1_s2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=1;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 3: Server checks cookie -->
        <mxCell id="s3" value="Check cm_device_token&#xa;cookie → lookup in SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="185" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s2_s3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" source="s2" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision: known? -->
        <mxCell id="d1" value="Known&#xa;device?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="250" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_s3_d1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=1;" edge="1" source="s3" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Yes: return status -->
        <mxCell id="s4_yes" value="Return approved/pending&#xa;status to browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="340" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_d1_yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1;fontSize=9;fontColor=#2E7D32;" edge="1" source="d1" target="s4_yes" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- No: generate token -->
        <mxCell id="s5_no" value="Generate device token&#xa;crypto.randomUUID()&#xa;(fallback for non-HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_d1_no" value="no" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C62828;strokeWidth=1;fontSize=9;fontColor=#C62828;" edge="1" source="d1" target="s5_no" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="280"/>
              <mxPoint x="350" y="355"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 6: POST register -->
        <mxCell id="s6" value="POST /api/auth/register&#xa;{ token: '...' }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="405" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s5_s6" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=1;" edge="1" source="s5_no" target="s6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 7: Server creates device -->
        <mxCell id="s7" value="SHA-256 hash token&#xa;Store in SQLite&#xa;Set httpOnly cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_s6_s7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" source="s6" target="s7" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision: first device? -->
        <mxCell id="d2" value="First&#xa;device?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="475" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_s7_d2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=1;" edge="1" source="s7" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- First device: auto-approve as admin -->
        <mxCell id="s8_first" value="Auto-approve as ADMIN&#xa;→ full access immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="565" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_d2_first" value="yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1;fontSize=9;fontColor=#2E7D32;" edge="1" source="d2" target="s8_first" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Subsequent: pending -->
        <mxCell id="s9_pending" value="Status: PENDING&#xa;API returns 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_d2_sub" value="no" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C62828;strokeWidth=1;fontSize=9;fontColor=#C62828;" edge="1" source="d2" target="s9_pending" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="505"/>
              <mxPoint x="350" y="510"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Pending UI -->
        <mxCell id="s10_wait" value="Show &quot;Waiting for&#xa;admin approval&quot; screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s9_s10" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=1;" edge="1" source="s9_pending" target="s10_wait" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin sees device -->
        <mxCell id="s11_admin" value="Device appears in&#xa;DeviceManager panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="720" y="490" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s9_s11" value="notification" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=1;dashed=1;fontSize=9;fontColor=#888888;" edge="1" source="s9_pending" target="s11_admin" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="550"/>
              <mxPoint x="180" y="550"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Admin approves -->
        <mxCell id="s12_approve" value="POST /api/auth/&#xa;devices/:id/approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="720" y="560" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s11_s12" value="approve" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1;fontSize=9;fontColor=#2E7D32;" edge="1" source="s11_admin" target="s12_approve" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Device approved -->
        <mxCell id="s13_approved" value="Device status → approved&#xa;Full API access granted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_s12_s13" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1;" edge="1" source="s12_approve" target="s13_approved" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- All API requests -->
        <mxCell id="s14_hook" value="&lt;b&gt;Every API request:&lt;/b&gt;&#xa;onRequest hook checks cookie&#xa;→ lookup device in SQLite&#xa;→ 401 if unknown&#xa;→ 403 if pending&#xa;→ attach device to request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="700" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- Cookie details -->
        <mxCell id="cookie_note" value="&lt;b&gt;Cookie: cm_device_token&lt;/b&gt;&#xa;httpOnly · sameSite: lax&#xa;maxAge: 10 years&#xa;path: /" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=#FFF9C4;strokeColor=#F9A825;rounded=1;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="90" width="240" height="65" as="geometry"/>
        </mxCell>

        <!-- Security notes -->
        <mxCell id="sec_notes" value="&lt;b&gt;Security notes&lt;/b&gt;&#xa;&#xa;• Token hashed (SHA-256) before storage&#xa;• Plain token only in httpOnly cookie&#xa;• sameSite: lax (not strict) for mobile&#xa;  initial navigation compatibility&#xa;• First device auto-admin prevents lockout&#xa;• ADMIN_RESET_TOKEN env var for&#xa;  emergency recovery&#xa;• Admin cannot revoke own device" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=#FCE4EC;strokeColor=#C62828;rounded=1;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="170" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- Admin capabilities -->
        <mxCell id="admin_caps" value="&lt;b&gt;Admin capabilities&lt;/b&gt;&#xa;&#xa;• Approve pending devices&#xa;• Revoke device access&#xa;• Rename devices&#xa;• View all registered devices&#xa;• Full instance management" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#2E7D32;rounded=1;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="355" width="240" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
