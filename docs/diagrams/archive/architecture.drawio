        <mxCell id="backup" value="&lt;b&gt;Backup strategy:&lt;/b&gt; git push — settings and memory restored on clone. Each instance re-auths on first use.&#xa;Workspace volumes (code) are NOT git-tracked — each instance clones its repos independently." style="text;html=1;fontSize=9;align=left;verticalAlign=top;overflow=hidden;fillColor=#FFF9C4;strokeColor=#F9A825;rounded=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="data_zone">
          <mxGeometry x="15" y="180" width="530" height="45" as="geometry"/>
        </mxCell>

        <!-- Isolation note -->
        <mxCell id="isolation" value="&lt;b&gt;Isolation model:&lt;/b&gt;&#xa;• Workspace code — dedicated Docker volume per instance&#xa;• Project memory — isolated bind mount per instance&#xa;• Auth — per-instance (claude login + gh auth login)&#xa;• Global settings + memory — shared via data/claude-home/&#xa;• Shared files — explicit opt-in via /shared&#xa;• No cross-contamination of customer data" style="text;html=1;fontSize=9;align=left;verticalAlign=top;overflow=hidden;fillColor=#E8F5E9;strokeColor=#2E7D32;rounded=1;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="data_zone">
          <mxGeometry x="15" y="240" width="380" height="100" as="geometry"/>
        </mxCell>

