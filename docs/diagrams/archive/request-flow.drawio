<mxfile>
  <diagram name="Request Flow" id="request-flow">
    <mxGraphModel dx="1500" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1020">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Claude Manager — Instance Lifecycle &amp; Real-Time Updates" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="325" y="15" width="550" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="REST API · Docker event stream · WebSocket broadcast · Container discovery &amp; adoption" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="325" y="48" width="550" height="20" as="geometry"/>
        </mxCell>

        <!-- ===== BROWSER ===== -->
        <mxCell id="browser" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="85" width="320" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="br_label" value="&lt;b&gt;React 19 Frontend&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;rounded=1;" vertex="1" parent="browser">
          <mxGeometry x="60" y="8" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Dashboard -->
        <mxCell id="dashboard" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;container=1;collapsible=0;" vertex="1" parent="browser">
          <mxGeometry x="15" y="45" width="290" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="dash_label" value="&lt;b&gt;Dashboard.jsx&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1565C0;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="dashboard">
          <mxGeometry x="8" y="5" width="150" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="dash_desc" value="Unified grid: managed + unmanaged containers&#xa;InstanceCard per container (status, actions)&#xa;NewInstanceModal — create form&#xa;ActivityLog — collapsible history panel" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="dashboard">
          <mxGeometry x="8" y="25" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- useInstances hook -->
        <mxCell id="hook" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;container=1;collapsible=0;" vertex="1" parent="browser">
          <mxGeometry x="15" y="175" width="290" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="hook_label" value="&lt;b&gt;useInstances() hook&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1565C0;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="hook">
          <mxGeometry x="8" y="5" width="200" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="hook_desc" value="• Initial fetch: GET /api/instances&#xa;• WebSocket: /api/instances/events&#xa;• On any event → re-fetch full list&#xa;• Reconnect: exponential backoff (1s → 30s)" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="hook">
          <mxGeometry x="8" y="25" width="270" height="75" as="geometry"/>
        </mxCell>

        <!-- Actions -->
        <mxCell id="actions" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;container=1;collapsible=0;" vertex="1" parent="browser">
          <mxGeometry x="15" y="305" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="act_label" value="&lt;b&gt;User actions (api.js)&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1565C0;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="actions">
          <mxGeometry x="8" y="5" width="200" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="act_desc" value="create(name, image) · start(id) · stop(id)&#xa;remove(id, removeVolume) · recreate(id, opts)&#xa;adopt(dockerId, name)" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="actions">
          <mxGeometry x="8" y="25" width="270" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== FASTIFY BACKEND ===== -->
        <mxCell id="backend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="85" width="360" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="be_label" value="&lt;b&gt;Fastify 5 Backend&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=#E65100;fontColor=#FFFFFF;strokeColor=none;rounded=1;" vertex="1" parent="backend">
          <mxGeometry x="80" y="8" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Auth hook -->
        <mxCell id="auth_hook" value="&lt;b&gt;onRequest hook&lt;/b&gt;: cookie → SHA-256 → SQLite lookup&#xa;401 unknown · 403 pending · attach device to request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;align=left;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="backend">
          <mxGeometry x="15" y="45" width="320" height="45" as="geometry"/>
        </mxCell>

        <!-- REST routes -->
        <mxCell id="rest" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;container=1;collapsible=0;" vertex="1" parent="backend">
          <mxGeometry x="15" y="105" width="320" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="rest_label" value="&lt;b&gt;routes/instances.js&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="rest">
          <mxGeometry x="8" y="5" width="200" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="rest_endpoints" value="GET    /api/instances              — list all&#xa;POST   /api/instances              — create new&#xa;GET    /api/instances/:id          — get one&#xa;POST   /api/instances/:id/start    — start&#xa;POST   /api/instances/:id/stop     — stop&#xa;POST   /api/instances/:id/recreate — toggle socket&#xa;DELETE /api/instances/:id          — remove&#xa;GET    /api/instances/discover     — find adoptable&#xa;POST   /api/instances/adopt        — adopt existing" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;fontFamily=monospace;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="rest">
          <mxGeometry x="8" y="25" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- WebSocket events -->
        <mxCell id="ws_events" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;container=1;collapsible=0;" vertex="1" parent="backend">
          <mxGeometry x="15" y="295" width="320" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="ws_label" value="&lt;b&gt;WebSocket event broadcast&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="ws_events">
          <mxGeometry x="8" y="5" width="250" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="ws_desc" value="GET /api/instances/events (WebSocket upgrade)&#xa;Docker event stream → filter by managed label&#xa;Broadcast to all connected clients:&#xa;  INSTANCE_CREATED · INSTANCE_UPDATED · INSTANCE_REMOVED" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="ws_events">
          <mxGeometry x="8" y="25" width="310" height="75" as="geometry"/>
        </mxCell>

        <!-- ===== DOCKER / SQLITE ===== -->
        <mxCell id="docker" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="810" y="85" width="340" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="docker_label" value="&lt;b&gt;Data Layer&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=#666666;fontColor=#FFFFFF;strokeColor=none;rounded=1;" vertex="1" parent="docker">
          <mxGeometry x="70" y="8" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Docker Engine -->
        <mxCell id="engine" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;container=1;collapsible=0;" vertex="1" parent="docker">
          <mxGeometry x="15" y="50" width="310" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="eng_label" value="&lt;b&gt;Docker Engine (source of truth)&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="engine">
          <mxGeometry x="8" y="5" width="290" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="eng_desc" value="Container state (running/stopped/created)&#xa;Image info, port mappings&#xa;Mounts &amp; bind configuration&#xa;Event stream (create/start/stop/destroy)&#xa;&#xa;&lt;b&gt;docker.js&lt;/b&gt; (dockerode wrapper):&#xa;  createInstance → volume + binds + labels&#xa;  learnMountTemplate → copy shared binds&#xa;  discoverContainers → find claude-* containers" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="engine">
          <mxGeometry x="8" y="25" width="290" height="145" as="geometry"/>
        </mxCell>

        <!-- SQLite -->
        <mxCell id="sqlite" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;container=1;collapsible=0;" vertex="1" parent="docker">
          <mxGeometry x="15" y="255" width="310" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="sql_label" value="&lt;b&gt;SQLite (supplemental metadata)&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1565C0;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="sqlite">
          <mxGeometry x="8" y="5" width="290" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="sql_desc" value="&lt;b&gt;instances&lt;/b&gt; — id, name, docker_id, notes, tags&#xa;&lt;b&gt;devices&lt;/b&gt; — token_hash, approved, is_admin&#xa;&lt;b&gt;activity_log&lt;/b&gt; — action, instance_id, timestamp&#xa;&#xa;Docker state + SQLite metadata merged&#xa;in instances.js mergeInstances()" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="sqlite">
          <mxGeometry x="8" y="25" width="290" height="105" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->
        <!-- Browser actions → Backend REST -->
        <mxCell id="e_act_rest" value="REST API" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=2;fontSize=9;fontColor=#E65100;fontStyle=1;" edge="1" source="actions" target="rest" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Backend REST → Docker -->
        <mxCell id="e_rest_docker" value="dockerode" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=2;fontSize=9;fontColor=#E65100;fontStyle=1;" edge="1" source="rest" target="engine" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Backend REST → SQLite -->
        <mxCell id="e_rest_sql" value="better-sqlite3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=2;fontSize=9;fontColor=#1565C0;fontStyle=1;" edge="1" source="rest" target="sqlite" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- WS events ← Docker events -->
        <mxCell id="e_docker_ws" value="event stream" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=2;fontSize=9;fontColor=#2E7D32;fontStyle=1;dashed=1;" edge="1" source="engine" target="ws_events" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- WS events → Browser hook -->
        <mxCell id="e_ws_hook" value="broadcast" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=2;fontSize=9;fontColor=#2E7D32;fontStyle=1;dashed=1;" edge="1" source="ws_events" target="hook" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== CREATE INSTANCE FLOW ===== -->
        <mxCell id="create_flow" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="560" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="cf_label" value="&lt;b&gt;Create instance flow&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#2E7D32;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="8" width="250" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="cf1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="40" width="25" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cf1t" value="Check MAX_INSTANCES limit" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="create_flow">
          <mxGeometry x="45" y="40" width="200" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="cf2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="70" width="25" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cf2t" value="Ensure image available (pull if needed)" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="create_flow">
          <mxGeometry x="45" y="70" width="220" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="cf3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="100" width="25" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cf3t" value="Create Docker volume: cmv-{slug}-{id}" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="create_flow">
          <mxGeometry x="45" y="100" width="220" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="cf4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="130" width="25" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cf4t" value="Learn bind mounts from existing containers (template)" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="create_flow">
          <mxGeometry x="45" y="130" width="280" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="cf5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="160" width="25" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cf5t" value="Create per-instance memory dir: data/instance-memory/{slug}/" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="create_flow">
          <mxGeometry x="45" y="160" width="340" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="cf6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;" vertex="1" parent="create_flow">
          <mxGeometry x="15" y="190" width="25" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cf6t" value="Create container with labels + binds + network → auto-start → broadcast event" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="create_flow">
          <mxGeometry x="45" y="190" width="500" height="25" as="geometry"/>
        </mxCell>

        <!-- ===== DISCOVERY FLOW ===== -->
        <mxCell id="discover_flow" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="785" width="560" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="df_label" value="&lt;b&gt;Container discovery &amp; adoption&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#E65100;" vertex="1" parent="discover_flow">
          <mxGeometry x="15" y="8" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="df_desc" value="&lt;b&gt;Discovery:&lt;/b&gt; GET /api/instances/discover&#xa;• Query all Docker containers&#xa;• Filter by image name (claude-workspace) or container name pattern (claude-*)&#xa;• Exclude already-managed (labeled) and already-adopted (SQLite docker_id)&#xa;• Return as &quot;unmanaged&quot; in unified grid&#xa;&#xa;&lt;b&gt;Adoption:&lt;/b&gt; POST /api/instances/adopt { dockerId, name }&#xa;• Register by docker_id in SQLite (can't modify labels on running containers)&#xa;• Generate manager ID, log activity&#xa;• Container now appears as managed, can be started/stopped/terminaled&#xa;• Mount template cache invalidated → new container's mounts can be learned" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="discover_flow">
          <mxGeometry x="15" y="32" width="530" height="155" as="geometry"/>
        </mxCell>

        <!-- ===== REAL-TIME UPDATE LOOP ===== -->
        <mxCell id="rt_loop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="630" y="540" width="560" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="rt_label" value="&lt;b&gt;Real-time update loop (no polling)&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#7B1FA2;" vertex="1" parent="rt_loop">
          <mxGeometry x="15" y="8" width="350" height="22" as="geometry"/>
        </mxCell>

        <!-- Flow boxes -->
        <mxCell id="rt1" value="Docker event&#xa;(container action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=9;" vertex="1" parent="rt_loop">
          <mxGeometry x="15" y="45" width="115" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="rt2" value="Filter by&#xa;managed=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=9;" vertex="1" parent="rt_loop">
          <mxGeometry x="155" y="45" width="105" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="rt3" value="Broadcast to&#xa;all WebSocket&#xa;clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=9;" vertex="1" parent="rt_loop">
          <mxGeometry x="285" y="45" width="105" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="rt4" value="useInstances()&#xa;re-fetches&#xa;full list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=9;" vertex="1" parent="rt_loop">
          <mxGeometry x="415" y="45" width="115" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="e_rt1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7B1FA2;strokeWidth=1;" edge="1" source="rt1" target="rt2" parent="rt_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rt2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7B1FA2;strokeWidth=1;" edge="1" source="rt2" target="rt3" parent="rt_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rt3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7B1FA2;strokeWidth=1;" edge="1" source="rt3" target="rt4" parent="rt_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rt_note" value="Event stream auto-reconnects on error (3s delay) and on end (3s delay).&#xa;WebSocket clients reconnect with exponential backoff (1s → 30s).&#xa;Result: UI always shows current container state without manual refresh." style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="rt_loop">
          <mxGeometry x="15" y="105" width="530" height="55" as="geometry"/>
        </mxCell>

        <!-- Mount template learning -->
        <mxCell id="mt_flow" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="630" y="740" width="560" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="mt_label" value="&lt;b&gt;Mount template learning&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#F9A825;" vertex="1" parent="mt_flow">
          <mxGeometry x="15" y="8" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="mt_desc" value="When creating a new instance, the manager learns bind mounts from existing containers&#xa;to ensure consistency (shared dirs, .claude config, etc.):&#xa;&#xa;&lt;b&gt;Search order:&lt;/b&gt;&#xa;  1. Managed containers (claude-manager.managed=true label)&#xa;  2. Adopted containers (docker_id in SQLite)&#xa;  3. Unmanaged claude-workspace containers (image/name pattern match)&#xa;&#xa;&lt;b&gt;Filtering:&lt;/b&gt;&#xa;  Skip /workspace (per-instance volume), docker.sock, /data (manager-only)&#xa;  Explicit INSTANCE_*_DIR config vars take precedence over learned mounts&#xa;&#xa;&lt;b&gt;Caching:&lt;/b&gt;&#xa;  Template cached after first learn, invalidated on container adoption" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#555555;overflow=hidden;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="mt_flow">
          <mxGeometry x="15" y="30" width="530" height="200" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
