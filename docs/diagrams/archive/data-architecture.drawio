        <!-- Key insight: what overlaps -->
        <mxCell id="overlap" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;container=1;collapsible=0;" vertex="1" parent="cont_fs">
          <mxGeometry x="15" y="385" width="620" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ov_label" value="&lt;b&gt;How mounts compose inside the container&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#F9A825;" vertex="1" parent="overlap">
          <mxGeometry x="10" y="5" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="ov_desc" value="&lt;b&gt;/workspace/.claude&lt;/b&gt; is a bind mount OVER the volume at /workspace — Docker overlays it.&#xa;This means the volume holds code repos, but .claude/ comes from the host's per-instance memory dir.&#xa;&#xa;&lt;b&gt;/home/claude/.claude&lt;/b&gt; is the shared global config — settings, CLAUDE.md, and global memory.&#xa;Claude Code reads project-level config from /workspace/.claude and user-level from ~/.claude.&#xa;Result: shared global prefs + memory, isolated project context, and per-instance auth." style="text;html=1;fontSize=9;align=left;verticalAlign=top;overflow=hidden;fillColor=none;strokeColor=none;fontColor=#555555;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="overlap">
          <mxGeometry x="10" y="25" width="600" height="110" as="geometry"/>
        </mxCell>

        <!-- Shared config callout -->
        <mxCell id="shared_config" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;container=1;collapsible=0;" vertex="1" parent="containers">
          <mxGeometry x="20" y="590" width="650" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="sc_label" value="&lt;b&gt;Shared config, per-instance auth&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#2E7D32;" vertex="1" parent="shared_config">
          <mxGeometry x="10" y="8" width="400" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="sc_desc" value="data/claude-home/ is bind-mounted as ~/.claude in every instance, so these are shared:&#xa;&#xa;  • settings.json — Claude preferences&#xa;  • CLAUDE.md — global instructions (e.g. brief.md convention)&#xa;  • memory/ — global memories&#xa;&#xa;&lt;b&gt;Auth is NOT shared.&lt;/b&gt; Each container runs its own:&#xa;  • &amp;quot;claude login&amp;quot; (Max) — credentials live inside the container, not in data/&#xa;  • &amp;quot;gh auth login&amp;quot; (device flow) — GitHub token in ~/.config/gh/, per-container&#xa;&#xa;Backup: clone the repo + docker compose up → settings and memory are restored.&#xa;Each instance re-auths on first use. No cross-contamination of credentials between instances." style="text;html=1;fontSize=9;align=left;verticalAlign=top;overflow=hidden;fillColor=none;strokeColor=none;fontColor=#555555;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="shared_config">
          <mxGeometry x="10" y="30" width="630" height="155" as="geometry"/>
        </mxCell>

        <!-- ===== CONNECTION ARROWS ===== -->
        <!-- shared/ → /shared -->
        <mxCell id="e_shared" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" source="shared" target="fs_shared" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="170"/>
              <mxPoint x="650" y="425"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- claude-home/ → ~/.claude -->
        <mxCell id="e_claude" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=2;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" source="claude_home" target="fs_claude_home" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="184"/>
              <mxPoint x="660" y="372"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- instance-memory/ → /workspace/.claude -->
        <mxCell id="e_memory" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7B1FA2;strokeWidth=2;dashed=1;" edge="1" source="mem_a" target="fs_claude_proj" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="460"/>
              <mxPoint x="640" y="205"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- volumes → /workspace -->
        <mxCell id="e_volume" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=2;dashed=1;" edge="1" source="vol_a" target="fs_workspace" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="776"/>
              <mxPoint x="670" y="205"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
