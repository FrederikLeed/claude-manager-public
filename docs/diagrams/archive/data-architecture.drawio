        <mxCell id="fss_tree" value="templates/&#xa;  report-template.md&#xa;scripts/&#xa;  useful-tool.sh&#xa;uploads/&#xa;  latest-data.csv" style="text;html=1;fontSize=9;align=left;verticalAlign=top;overflow=hidden;fillColor=none;strokeColor=none;fontColor=#555555;fontFamily=monospace;spacingLeft=10;spacingTop=5;spacingRight=10;spacingBottom=5;" vertex="1" parent="fs_shared">
