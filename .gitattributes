# Force LF line endings for files that go into Docker images
# Windows CRLF breaks tmux, shell scripts, and other Linux tools
workspace/config/**    text eol=lf
workspace/entrypoint.sh text eol=lf
*.sh                   text eol=lf
*.conf                 text eol=lf
Dockerfile             text eol=lf
workspace/Dockerfile   text eol=lf
