# Claude Manager v2 configuration
# Copy this to .env and fill in your values

# --- Core ---
CLAUDE_IMAGE=claude-workspace:latest
MAX_INSTANCES=20

# --- Host paths (absolute paths on your Docker host) ---
# Linux example:
SHARED_DIR=/srv/claude-manager/data/shared
INSTANCE_SHARED_DIR=/srv/claude-manager/data/shared
INSTANCE_CLAUDE_DIR=/srv/claude-manager/data/claude-home
INSTANCE_MEMORY_BASE_DIR=/srv/claude-manager/data/instance-memory
# Windows example (uncomment and adjust):
# SHARED_DIR=C:\claude-manager\data\shared
# INSTANCE_SHARED_DIR=C:\claude-manager\data\shared
# INSTANCE_CLAUDE_DIR=C:\claude-manager\data\claude-home
# INSTANCE_MEMORY_BASE_DIR=C:\claude-manager\data\instance-memory

# --- Network ---
DEFAULT_NETWORK_POLICY=unrestricted

# --- LiteLLM (for local/cloud LLM backends) ---
LITELLM_MASTER_KEY=sk-change-me-to-a-random-string
LITELLM_DEFAULT_BUDGET=20

# Per-backend virtual keys (generated via LiteLLM /key/generate after first start)
LITELLM_KEY_LOCAL_LLM=
LITELLM_KEY_FOUNDRY=
LITELLM_KEY_FOUNDRY_LATEST=

# --- Azure AI Foundry (optional) ---
AZURE_AI_API_KEY=
AZURE_AI_API_BASE=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1
GPTLATEST_AZURE_AI_API_KEY=

# --- PostgreSQL (defaults are fine for local dev) ---
# POSTGRES_USER=litellm
# POSTGRES_PASSWORD=litellm
# POSTGRES_DB=litellm

# --- Admin ---
ADMIN_RESET_TOKEN=
