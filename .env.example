# Claude Manager configuration
PORT=3000
DATA_DIR=/data
CLAUDE_IMAGE=claude-workspace:latest
CLAUDE_NETWORK=claude-manager-net
MAX_INSTANCES=10

# Timezone — propagated into the manager and every instance it creates so
# in-container logs/timestamps match your wall clock. IANA name, e.g.
# Europe/Copenhagen, America/New_York. Defaults to UTC if unset.
TZ=UTC

# Shared directory — accessible to all instances as /shared
# Must be absolute HOST path for both variables
SHARED_DIR=D:\GitHub\claude-manager\data\shared
INSTANCE_SHARED_DIR=D:\GitHub\claude-manager\data\shared

# Global Claude config — shared auth + global memory across all instances
# Mounted as /home/claude/.claude in each instance
INSTANCE_CLAUDE_DIR=D:\GitHub\claude-manager\data\claude-home

# Per-instance project memory — each instance gets <base>/<slug>/ as /workspace/.claude
# Keeps project-specific Claude memory isolated between instances
INSTANCE_MEMORY_BASE_DIR=D:\GitHub\claude-manager\data\instance-memory

# Legacy: single shared project-memory dir (leave empty if using INSTANCE_MEMORY_BASE_DIR)
INSTANCE_MEMORY_DIR=

# Emergency admin reset token — set a secret value here.
# To recover admin access, visit: http://host:3000/?reset_token=YOUR_SECRET
# Leave empty to disable (recommended after initial setup).
ADMIN_RESET_TOKEN=
